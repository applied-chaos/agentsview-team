# Image tag: a release (vX.Y.Z), never latest, so a restart never pulls something new.
PLATFORM_VERSION=v0.3.2

# Public URL the Platform is served at (behind your TLS reverse proxy).
PLATFORM_BASE_URL=https://agentsview.example.com

# openssl rand -hex 32 for each. Losing PLATFORM_SECRET_KEY makes sealed Instance secrets unreadable: back it up.
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
PLATFORM_SECRET_KEY=

# OIDC sign-in. Register <PLATFORM_BASE_URL>/auth/callback as the redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
# OIDC_SCOPES=openid email profile
# OIDC_GROUPS_CLAIM=groups

# Who may sign in. Both empty: every login the issuer authenticates.
PLATFORM_ALLOWED_EMAIL_DOMAINS=
PLATFORM_REQUIRED_GROUP=
